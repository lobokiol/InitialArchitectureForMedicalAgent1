DASHSCOPE_API_KEY="your_dashscope_api_key"

# Local services
ES_URL=http://localhost:9200
REDIS_URI=redis://localhost:6379
RAG_KB_INDEX=rag_knowledge
DISEASE_KB_INDEX=disease_kb
RAG_DEPT_RULES_INDEX=rag_department_rules

# LLM (DashScope OpenAI-compatible)
CHAT_MODEL_NAME=qwen3.6-flash
CHAT_FALLBACK_MODEL_NAME=deepseek-v4-flash
EMBEDDING_MODEL_NAME=text-embedding-v2
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: true = no Redis (in-memory sessions/checkpoints; lost on restart)
USE_MEMORY_CHECKPOINTER=false

# Triage session persistence (eval / regression)
TRIAGE_SESSION_DB_PATH=data/triage_sessions.db
TRIAGE_SESSION_ENABLED=true

# MCP hospital tools
MCP_ENABLED=true
# Defaults to current Python interpreter + hospital_mcp/server.py
# MCP_SERVER_COMMAND=python hospital_mcp/server.py
MCP_FOLLOWUP_ENABLED=true
CHAT_TIMEOUT_SECONDS=60

# Auth / gateway
JWT_SECRET=dev-only-change-me-in-local-env!!
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7
WECHAT_APP_ID=
WECHAT_APP_SECRET=
CORS_ORIGINS=http://localhost:5173,https://servicewechat.com
# RATE_LIMIT_CHAT=10/minute   # 空或未设 = 不限
RATE_LIMIT_READ=60/minute
RATE_LIMIT_AUTH_IP=10/minute
MAX_REFRESH_PER_PHONE=3
